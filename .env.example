# Frontend (Vite reads VITE_* at build/runtime)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend tooling (DB_URL: used by psql for migrations + pgTAP tests)
# Use the Shared Pooler URL from Supabase Dashboard → Connect → Connection string → Shared Pooler
# (IPv4-friendly; works from any home network)
DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-<region>.pooler.supabase.com:5432/postgres

# IMPORTANT: also set the dedup salt on the cloud database (one-time, never commit the value):
#   psql "$DB_URL" -c "ALTER DATABASE postgres SET app.dedup_salt = 'pick-a-secret-string'"
